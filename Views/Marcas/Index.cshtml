@model IEnumerable<Proyecto_Ferreteria.Models.Marca>

@{
    ViewData["Title"] = "Gestión de Marcas";
}

<div class="container mt-5">
    <!-- Encabezado de la sección -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bolder text-dark mb-0">Gestión de Marcas</h2>
            <p class="text-muted mb-0">Administra las marcas registradas de tus productos.</p>
        </div>
        <a asp-action="Create" class="btn btn-warning fw-bold text-dark px-4 py-2 rounded-pill shadow-sm">
            <span class="fs-5 me-1">+</span> Nueva Marca
        </a>
    </div>

    <!-- Tarjeta de la Tabla -->
    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="py-3 ps-4 text-secondary text-uppercase" style="font-size: 0.85rem;">Nombre de la Marca</th>
                            <th class="py-3 pe-4 text-secondary text-uppercase text-end" style="font-size: 0.85rem; width: 300px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="transition: all 0.2s ease-in-out;">
                                <td class="py-3 ps-4 fw-bold text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                            🏷️
                                        </div>
                                        @Html.DisplayFor(modelItem => item.Nombre)
                                    </div>
                                </td>
                                <td class="py-3 pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@item.IdMarca" class="btn btn-sm btn-light text-primary fw-bold rounded-pill px-3 me-1">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@item.IdMarca" class="btn btn-sm btn-light text-dark fw-bold rounded-pill px-3 me-1">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdMarca" class="btn btn-sm btn-light text-danger fw-bold rounded-pill px-3">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>