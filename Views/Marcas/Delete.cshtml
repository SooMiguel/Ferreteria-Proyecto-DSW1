@model Proyecto_Ferreteria.Models.Marca

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4 border-top border-danger border-5">
                <div class="card-body p-5 text-center">
                    <div class="text-danger mb-4">
                        <span style="font-size: 5rem;">⚠️</span>
                    </div>

                    <h2 class="fw-bold text-dark">Confirmar Eliminación</h2>
                    <p class="text-muted mb-4">¿Realmente desea eliminar la marca <strong>"@Model.Nombre"</strong>? Los productos asociados podrían verse afectados.</p>

                    <div class="bg-light p-4 rounded-3 mb-4 border">
                        <span class="text-secondary small d-block">Marca a dar de baja:</span>
                        <span class="fs-3 fw-bold text-danger">@Model.Nombre</span>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdMarca" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">
                                Sí, Eliminar de la Base de Datos
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar y Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>