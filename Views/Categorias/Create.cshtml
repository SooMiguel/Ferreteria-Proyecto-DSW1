@model Proyecto_Ferreteria.Models.Categoria

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0">✨ Registrar Nueva Categoría</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej: Pinturas, Electricidad..." />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">Guardar Categoría</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar y Volver</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>