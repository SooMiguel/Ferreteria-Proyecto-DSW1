@model Proyecto_Ferreteria.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-lg border-0 rounded-4 border-top border-danger border-5">
                <div class="card-body p-5 text-center">

                    <div class="mb-4">
                        <span class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex justify-content-center align-items-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            🗑️
                        </span>
                    </div>

                    <h3 class="fw-bolder text-dark">¿Eliminar Categoría?</h3>
                    <p class="text-muted mb-4">Estás a punto de borrar esta categoría permanentemente. Esta acción no se puede deshacer.</p>

                    <div class="bg-light rounded-4 p-4 mb-5 border">
                        <p class="text-secondary small fw-bold text-uppercase mb-1">Categoría seleccionada:</p>
                        <h4 class="fw-bold text-dark mb-0">@Html.DisplayFor(model => model.Nombre)</h4>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdCategoria" />
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill fw-bold text-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-4 rounded-pill fw-bold shadow-sm">
                                Sí, Eliminar Definitivamente
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>