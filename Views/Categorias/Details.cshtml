@model Proyecto_Ferreteria.Models.Categoria

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white p-4 text-center">
                    <h3 class="mb-0">🔍 Detalles de la Categoría</h3>
                </div>
                <div class="card-body p-5">
                    <div class="mb-4 text-center">
                        <div class="display-1 text-info mb-3">📁</div>
                        <h5 class="text-muted small text-uppercase fw-bold">Nombre Registrado</h5>
                        <p class="display-6 fw-bold text-dark">@Model.Nombre</p>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.IdCategoria" class="btn btn-primary btn-lg fw-bold shadow-sm">
                            Editar Información
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Volver al Listado
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <small class="text-muted">ID de Registro: #@Model.IdCategoria</small>
                </div>
            </div>
        </div>
    </div>
</div>