@model Proyecto_Ferreteria.Models.Categoria

@{
    ViewData["Title"] = "Detalle de Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <h5 class="mb-0 fw-bold">Ficha de la Categoría</h5>
                </div>

                <div class="card-body p-5 text-center">
                    <p class="text-muted text-uppercase fw-bold small mb-1">Identificador: #@Model.IdCategoria</p>
                    <h2 class="fw-bolder text-dark mb-4">@Html.DisplayFor(model => model.Nombre)</h2>

                    <div class="d-flex justify-content-center gap-3 mt-5">
                        <a asp-action="Edit" asp-route-id="@Model?.IdCategoria" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">
                            Editar Información
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-bold">
                            Volver al Listado
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>