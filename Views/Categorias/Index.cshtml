@model IEnumerable<Proyecto_Ferreteria.Models.Categoria>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><span class="me-2">📂</span> Gestión de Categorías</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm fw-bold">
            + Nueva Categoría
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4 py-3">Nombre de la Categoría</th>
                        <th class="text-center py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">
                                <span class="me-2">📁</span> @item.Nombre
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="Edit" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-outline-info">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>