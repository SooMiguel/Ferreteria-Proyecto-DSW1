@model IEnumerable<Proyecto_Ferreteria.Models.Producto>

@{
    ViewData["Title"] = "Tienda Online";
}

<style>
    /* Efecto visual elegante al pasar el mouse sobre el producto */
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.15) !important;
        }

    .img-container {
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8f9fa;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        padding: 1.5rem;
    }

        .img-container img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

    .desc-truncate {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container mt-4 mb-5">
    <!-- Encabezado de la Tienda -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-dark text-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bolder mb-1">Catálogo de Productos</h2>
            <p class="text-light text-opacity-75 mb-0">Encuentra las mejores herramientas y materiales.</p>
        </div>

        <!-- Botón del Carrito con la lógica original y la bolita roja -->
        <button type="button" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow position-relative" onclick="abrirCarrito()">
            <span class="fs-5 me-2">🛒</span> Ver Mi Carrito
            <span id="contadorCarrito" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light border-2">
                0
            </span>
        </button>
    </div>

    <!-- Cuadrícula de Productos Premium -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-2">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 product-card">
                    <div class="img-container position-relative">
                        <img src="@item.ImagenUrl" onerror="this.src='/img/default-product.png'" alt="@item.Nombre">
                        @if (item.Stock <= 5 && item.Stock > 0)
                        {
                            <span class="position-absolute top-0 end-0 badge bg-danger rounded-pill m-3 shadow-sm px-2 py-1">
                                ¡Últimas @item.Stock!
                            </span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <div class="mb-2">
                            <span class="badge bg-secondary">@item.Marca.Nombre</span>
                            <span class="badge bg-info text-dark">@item.Categoria.Nombre</span>
                        </div>

                        <h5 class="card-title fw-bolder text-dark mb-1">@item.Nombre</h5>
                        <p class="card-text text-muted small flex-grow-1 desc-truncate">
                            @item.Descripcion
                        </p>

                        <div class="mt-3">
                            <span class="fs-3 fw-black text-primary" style="font-weight: 900;">S/ @item.Precio.ToString("0.00")</span>
                            <div class="text-success small fw-bold">Stock disponible: @item.Stock unid.</div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 p-4 pt-0">
                        @if (item.Stock > 0)
                        {
                            <!-- Botón de agregar conectado a tu JS original -->
                            <button type="button" class="btn btn-dark w-100 fw-bold rounded-pill shadow-sm py-2"
                                    onclick="agregarAlCarrito(@item.IdProducto, '@item.Nombre.Replace("'", "\\'")', @item.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                Añadir al Carrito
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-light w-100 fw-bold text-secondary rounded-pill py-2" disabled>
                                🚫 Agotado
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ==========================================
     MODAL DEL CARRITO
=========================================== -->
<div class="modal fade" id="modalCarrito" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-4">
                <h5 class="modal-title fw-bold">🛒 Mi Carrito de Compras</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Precio</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoCarrito">
                    </tbody>
                </table>
                <div class="text-end border-top pt-3 mt-3">
                    <h4 class="fw-bold text-dark">Total a Pagar: <span id="totalCarrito" class="text-primary fs-3">S/ 0.00</span></h4>
                </div>
            </div>
            <div class="modal-footer p-4 bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Seguir Comprando</button>
                <button type="button" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm" onclick="procesarPago()">Pagar Ahora</button>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     SCRIPTS DEL CARRITO
=========================================== -->
@section Scripts {
    <script>
        let carrito = JSON.parse(localStorage.getItem('carritoFerreteria')) || [];

        // Ejecutar al cargar la página para actualizar la bolita roja
        actualizarContador();

        function agregarAlCarrito(id, nombre, precio) {
            let itemExistente = carrito.find(p => p.id === id);

            if (itemExistente) {
                itemExistente.cantidad += 1;
            } else {
                carrito.push({
                    id: id,
                    nombre: nombre,
                    precio: parseFloat(precio),
                    cantidad: 1
                });
            }

            localStorage.setItem('carritoFerreteria', JSON.stringify(carrito));
            actualizarContador();
        }

        function actualizarContador() {
            let totalItems = carrito.reduce((total, item) => total + item.cantidad, 0);
            document.getElementById('contadorCarrito').innerText = totalItems;
        }

        function abrirCarrito() {
            let cuerpoTabla = document.getElementById('cuerpoCarrito');
            let html = '';
            let sumaTotal = 0;

            if (carrito.length === 0) {
                html = '<tr><td colspan="5" class="text-center text-muted py-5">Tu carrito está vacío 😔</td></tr>';
            } else {
                carrito.forEach((item, index) => {
                    let subtotal = item.precio * item.cantidad;
                    sumaTotal += subtotal;

                    html += `
                        <tr>
                            <td class="fw-bold text-dark">${item.nombre}</td>
                            <td class="text-center">S/ ${item.precio.toFixed(2)}</td>
                            <td class="text-center">
                                <span class="badge bg-secondary fs-6 rounded-pill px-3 py-2">${item.cantidad}</span>
                            </td>
                            <td class="text-end fw-bold text-primary">S/ ${subtotal.toFixed(2)}</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-danger rounded-circle fw-bold" onclick="eliminarItem(${index})" style="width: 32px; height: 32px;">X</button>
                            </td>
                        </tr>
                    `;
                });
            }

            cuerpoTabla.innerHTML = html;
            document.getElementById('totalCarrito').innerText = 'S/ ' + sumaTotal.toFixed(2);

            // CORRECCIÓN DEL FONDO OSCURO (BACKDROP BUG)
            let modalElement = document.getElementById('modalCarrito');
            let miModal = bootstrap.Modal.getInstance(modalElement);

            if (!miModal) {
                miModal = new bootstrap.Modal(modalElement);
            }

            miModal.show();
        }

        function eliminarItem(index) {
            carrito.splice(index, 1);
            localStorage.setItem('carritoFerreteria', JSON.stringify(carrito));
            actualizarContador();
            abrirCarrito();
        }

        function procesarPago() {
            if (carrito.length === 0) {
                alert("No hay nada en el carrito para pagar.");
                return;
            }

            let btnPagar = document.querySelector('.btn-success');
            btnPagar.innerHTML = "Procesando...";
            btnPagar.disabled = true;

            fetch('/Tienda/ProcesarPago', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(carrito)
            })
            .then(response => response.json())
            .then(data => {
                if (data.exito) {
                    alert("🎉 " + data.mensaje);
                    carrito = [];
                    localStorage.removeItem('carritoFerreteria');
                    window.location.reload();
                } else {
                    alert("❌ Error: " + data.mensaje);
                    btnPagar.innerHTML = "Pagar Ahora";
                    btnPagar.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("Hubo un error de comunicación con el servidor.");
                btnPagar.innerHTML = "Pagar Ahora";
                btnPagar.disabled = false;
            });
        }
    </script>
}