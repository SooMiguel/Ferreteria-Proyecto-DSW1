@model IEnumerable<Proyecto_Ferreteria.Models.VentasViewModel>

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="container-fluid px-4 mt-5">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bolder text-dark mb-0">Reporte de Ventas</h2>
            <p class="text-muted mb-0">Consulta el historial detallado de transacciones y facturación.</p>
        </div>
    </div>

    <!-- Panel de Filtros Moderno -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="date" name="inicio" class="form-control bg-light border-0" id="filtroInicio" />
                        <label for="filtroInicio" class="text-secondary fw-bold">📅 Fecha de Inicio</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="date" name="fin" class="form-control bg-light border-0" id="filtroFin" />
                        <label for="filtroFin" class="text-secondary fw-bold">📅 Fecha de Fin</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm" style="height: 58px;">
                        Generar Reporte
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tarjeta de la Tabla de Ventas -->
    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="py-3 ps-4 text-secondary text-uppercase" style="font-size: 0.85rem;">N° Comprobante</th>
                            <th class="py-3 text-secondary text-uppercase" style="font-size: 0.85rem;">Cliente</th>
                            <th class="py-3 text-secondary text-uppercase" style="font-size: 0.85rem;">Fecha y Hora</th>
                            <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.85rem;">Estado</th>
                            <th class="py-3 pe-4 text-secondary text-uppercase text-end" style="font-size: 0.85rem;">Importe Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr style="transition: all 0.2s ease-in-out;">
                                    <td class="py-3 ps-4">
                                        <span class="badge bg-dark bg-opacity-10 text-dark px-3 py-2 rounded-pill fw-bold border">
                                            #VTA-@item.IdVenta.ToString("D5")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                                👤
                                            </div>
                                            <span class="fw-bold text-dark">@item.Cliente</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-secondary">
                                            <span class="fw-semibold text-dark">@item.FechaVenta.ToString("dd/MM/yyyy")</span>
                                            <br>
                                            <small>@item.FechaVenta.ToString("HH:mm") hrs</small>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Estado.ToLower() == "pagado")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fw-bold">
                                                ✅ @item.Estado
                                            </span>
                                        }
                                        else if (item.Estado.ToLower() == "pendiente")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2 fw-bold">
                                                ⏳ @item.Estado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                @item.Estado
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 pe-4 text-end">
                                        <span class="fw-bolder fs-5 text-primary">S/ @item.ImporteTotal.ToString("N2")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <span style="font-size: 3rem;">📭</span>
                                        <h5 class="mt-3 fw-bold">No se encontraron ventas</h5>
                                        <p>Ajusta el filtro de fechas o realiza una nueva compra en la tienda.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>