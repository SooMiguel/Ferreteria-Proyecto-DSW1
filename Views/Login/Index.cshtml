@{
    Layout = null; // Pantalla completa, sin el menú superior
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Ferretería</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; }
        .login-card { border-radius: 15px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1); }
        .btn-brand { background-color: #fd7e14; border-color: #fd7e14; color: white; font-weight: bold; }
        .btn-brand:hover { background-color: #e86e04; color: white; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card login-card border-0">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                                <span class="fs-2">🛠️</span>
                            </div>
                            <h3 class="fw-bold text-dark">Bienvenido</h3>
                            <p class="text-muted">Ingresa a tu cuenta para continuar</p>
                        </div>

                        <!-- ALERTA DE ERROR -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger text-center shadow-sm">
                                @ViewBag.Error
                            </div>
                        }

                        <form asp-controller="Login" asp-action="Ingresar" method="post">
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" id="correoInput" name="Correo" placeholder="nombre@ejemplo.com" required>
                                <label for="correoInput">Correo Electrónico</label>
                            </div>

                            <div class="form-floating mb-4">
                                <input type="password" class="form-control" id="claveInput" name="Clave" placeholder="Contraseña" required>
                                <label for="claveInput">Contraseña</label>
                            </div>

                            <button type="submit" class="btn btn-brand w-100 py-2 mb-3">
                                Ingresar al Sistema
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>