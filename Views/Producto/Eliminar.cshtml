@model Proyecto_Ferreteria.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">¿Estás seguro de que deseas eliminar este producto?</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9 fw-bold">@Model.Nombre</dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@Model.Descripcion</dd>

                <dt class="col-sm-3">Marca</dt>
                <dd class="col-sm-9">@Model.Marca.Nombre</dd>

                <dt class="col-sm-3">Categoría</dt>
                <dd class="col-sm-9">@Model.Categoria.Nombre</dd>

                <dt class="col-sm-3">Precio</dt>
                <dd class="col-sm-9">S/ @Model.Precio</dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <form asp-action="Eliminar" method="post">
                <input type="hidden" asp-for="IdProducto" />
                <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
            </form>
        </div>
    </div>
</div>