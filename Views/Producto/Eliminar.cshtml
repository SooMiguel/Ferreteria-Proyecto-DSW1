@model Proyecto_Ferreteria.Models.Producto

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4 border-top border-danger border-5">
                <div class="card-body p-5 text-center">
                    <div class="text-danger mb-4">
                        <span style="font-size: 4rem;">🗑️</span>
                    </div>
                    <h2 class="fw-bold">Dar de baja producto</h2>
                    <p class="text-muted">¿Confirmas que deseas ocultar este producto del catálogo y del inventario activo?</p>

                    <div class="card bg-light border-0 mb-4 p-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-center">
                                <img src="@Model.ImagenUrl" class="img-fluid rounded" style="max-height: 80px;" onerror="this.src='/img/default-product.png'">
                            </div>
                            <div class="col-8 text-start">
                                <h5 class="mb-0 fw-bold">@Model.Nombre</h5>
                                <p class="mb-0 text-muted small">S/ @Model.Precio | Stock: @Model.Stock</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Eliminar">
                        <input type="hidden" asp-for="IdProducto" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">Confirmar Eliminación</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>