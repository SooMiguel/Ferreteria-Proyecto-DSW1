@model IEnumerable<Proyecto_Ferreteria.Models.Producto>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><span class="me-2">🛠️</span> Inventario de Productos</h2>
        <a asp-action="Agregar" class="btn btn-warning fw-bold shadow-sm">
            + Nuevo Producto
        </a>
    </div>

    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-striped align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th class="ps-3">Producto</th>
                    <th>Marca/Cat.</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold">@item.Nombre</div>
                            <small class="text-muted">@item.Descripcion</small>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@item.IdMarca</span>
                            <span class="badge bg-light text-dark border">@item.IdCategoria</span>
                        </td>
                        <td class="fw-bold text-success">S/ @item.Precio.ToString("N2")</td>
                        <td>
                            @if (item.Stock <= 10)
                            {
                                <span class="text-danger fw-bold">⚠️ @item.Stock</span>
                            }
                            else
                            {
                                <span class="text-dark">@item.Stock</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-danger">Baja</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>