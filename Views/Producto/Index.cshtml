@model IEnumerable<Proyecto_Ferreteria.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inventario de Herramientas y Materiales</h2>
        <a asp-action="Agregar" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> + Nuevo Producto
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Marca</th>
                            <th>Categoría</th>
                            <th>Precio (S/)</th>
                            <th>Stock</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle fw-bold">@item.Nombre</td>
                                    <td class="align-middle">@item.Descripcion</td>
                                    <td class="align-middle">
                                        <span class="badge bg-secondary">@item.Marca.Nombre</span>
                                    </td>
                                    <td class="align-middle">@item.Categoria.Nombre</td>
                                    <td class="align-middle">@item.Precio.ToString("0.00")</td>

                                    <td class="align-middle text-center">
                                        @if (item.Stock <= 5)
                                        {
                                            <span class="badge bg-danger">@item.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.Stock</span>
                                        }
                                    </td>

                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-warning">Editar</a>
                                            <a asp-action="Eliminar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No hay productos registrados en el sistema.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>