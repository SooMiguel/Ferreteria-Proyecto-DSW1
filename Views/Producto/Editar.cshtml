@model Proyecto_Ferreteria.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Producto</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="IdProducto" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Nombre" class="form-label fw-bold"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej: Taladro Percutor" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Descripcion" class="form-label fw-bold"></label>
                                <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Marca</label>
                                <select asp-for="IdMarca" class="form-select" asp-items="ViewBag.Marcas">
                                    <option value="">-- Seleccione Marca --</option>
                                </select>
                                <span asp-validation-for="IdMarca" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Categoría</label>
                                <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.Categorias">
                                    <option value="">-- Seleccione Categoría --</option>
                                </select>
                                <span asp-validation-for="IdCategoria" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Precio" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">S/</span>
                                    <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Precio" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label fw-bold"></label>
                                <input asp-for="Stock" class="form-control" type="number" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="ImagenUrl" class="form-label fw-bold">URL de la Imagen</label>
                                <input asp-for="ImagenUrl" class="form-control" placeholder="http://..." />
                                <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}