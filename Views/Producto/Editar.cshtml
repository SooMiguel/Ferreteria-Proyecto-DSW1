@model Proyecto_Ferreteria.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                    ✏️
                </div>
                <h3 class="fw-bolder text-dark">Editar Producto</h3>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <form asp-action="Editar">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdProducto" />

                        <div class="row g-4">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Nombre" class="form-control" id="floatingEditNombre" placeholder="Nombre" />
                                    <label asp-for="Nombre" for="floatingEditNombre">Nombre del Producto</label>
                                    <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="IdMarca" class="form-select" id="floatingEditMarca" asp-items="ViewBag.Marcas"></select>
                                    <label asp-for="IdMarca" for="floatingEditMarca">Marca</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="IdCategoria" class="form-select" id="floatingEditCat" asp-items="ViewBag.Categorias"></select>
                                    <label asp-for="IdCategoria" for="floatingEditCat">Categoría</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Precio" class="form-control text-primary fw-bold" id="floatingEditPrecio" type="number" step="0.01" />
                                    <label asp-for="Precio" for="floatingEditPrecio">Precio de Venta (S/)</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Stock" class="form-control" id="floatingEditStock" type="number" />
                                    <label asp-for="Stock" for="floatingEditStock">Stock Físico</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="ImagenUrl" class="form-control" id="floatingEditImg" placeholder="URL" />
                                    <label asp-for="ImagenUrl" for="floatingEditImg">URL de la Imagen</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Descripcion" class="form-control" id="floatingEditDesc" style="height: 100px"></textarea>
                                    <label asp-for="Descripcion" for="floatingEditDesc">Descripción</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 fw-bold text-secondary rounded-pill">Regresar</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold text-white rounded-pill shadow-sm">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}